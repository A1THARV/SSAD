.claude/settings.local.json

# The paper draft. Deliberately NOT tracked: it was committed once, then removed
# from all history with git-filter-repo before the repo could be shared. Keeping
# it ignored means the strip does not have to be repeated.
research paper v2.pdf
*.pdf
